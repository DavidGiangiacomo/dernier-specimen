[layer_names]

2d_physics/layer_1="monde"
2d_physics/layer_2="gojo"
2d_physics/layer_3="créatures"
2d_physics/layer_4="coups de Gojo"
2d_physics/layer_5="coups des créatures"
2d_physics/layer_6="analysable"

[physics]

common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
